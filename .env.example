# Copy to .env and fill in locally. Never commit real keys.
# Required for analysis, including regeneration from saved product descriptions.
DEEPSEEK_API_KEY=

# OpenAI-compatible gateway Base URL; use the address given by your provider.
# Usually ends with /v1; do not append /chat/completions.
# Blank uses the official DeepSeek endpoint.
DEEPSEEK_BASE_URL=

# Exact model ID from the provider. Blank uses deepseek-v4-pro.
DEEPSEEK_MODEL=

# Only required when fetching new products from Product Hunt.
PRODUCTHUNT_DEVELOPER_TOKEN=
